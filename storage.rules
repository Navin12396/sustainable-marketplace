rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images under items/
    match /items/{allPaths=**} {
      // Anyone can read images; only signed-in users can upload
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback for other assets: allow read, block writes
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
